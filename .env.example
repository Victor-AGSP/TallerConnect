# ============================================================
# TallerConnect - Plantilla de Variables de Entorno (Pública)
# ============================================================
# Copia este archivo como .env para configurar tu entorno local:
#   cp .env.example .env
#
# NOTA DE SEGURIDAD:
# En aplicaciones móviles (React Native/Expo), todas las variables
# prefijadas con EXPO_PUBLIC_ son visibles en el cliente compilado.
# NO almacenar claves secretas ni credenciales privadas aquí.
# ============================================================

# 1. ENTORNO DE LA APLICACIÓN
# Opciones disponibles: 'development' | 'integration' | 'production'
EXPO_PUBLIC_APP_ENV=development

# 2. URL BASE DE LA API GATEWAY
# ------------------------------------------------------------
# Opción A (Desarrollo Local con backend en tu máquina):
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Opción B (Gateway de integración en la nube, UCT):
# Con EXPO_PUBLIC_APP_ENV=integration y sin EXPO_PUBLIC_API_URL ya se usa esta URL.
# EXPO_PUBLIC_API_URL=https://api-tallerconnect.inf.uct.cl/api
# Nota: EXPO_PUBLIC_APP_ENV=production sin URL explícita usa la Gateway de
# producción configurada en src/config/env.ts, pendiente de actualización (D-11).

# Opción C (Emulador Android accediendo al localhost de tu PC):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# 3. MODO DE AUTENTICACIÓN Y SERVICIOS
# true  -> Usa datos simulados (mocks) sin requerir backend activo.
# false -> Conecta directamente con la API Gateway real.
EXPO_PUBLIC_USE_MOCK_AUTH=false
EXPO_PUBLIC_USE_MOCK_SERVICES=false
# Vistas estáticas de demostración: solo se habilitan junto con servicios mock.
EXPO_PUBLIC_DEMO_WORKFLOW=false
# Traza optativa: solo método, URL sin query ni credenciales y estado HTTP.
# EXPO_PUBLIC_HTTP_TRACE=false

# 4. TIMEOUTS Y CONTRATOS OPCIONALES DE LA API GATEWAY
# Timeout estándar de peticiones REST JSON (ms)
# EXPO_PUBLIC_API_TIMEOUT_MS=15000
# Timeout extendido para carga de evidencias multimedia hacia MS4 (ms)
# EXPO_PUBLIC_UPLOAD_TIMEOUT_MS=60000
# Habilitar consulta HTTP directa de avisos/notificaciones cuando el endpoint esté activo
# EXPO_PUBLIC_ENABLE_NOTIFICATIONS_API=false
