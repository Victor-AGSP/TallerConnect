# ============================================================
# TallerConnect - Plantilla de Variables de Entorno (Pública)
# ============================================================
# Copia este archivo como .env para configurar tu entorno local:
#   cp .env.example .env
#
# NOTA DE SEGURIDAD:
# En aplicaciones móviles (React Native/Expo), todas las variables
# prefijadas con EXPO_PUBLIC_ son visibles en el cliente compilado.
# NO almacenar claves secretas ni credenciales privadas aquí.
# ============================================================

# 1. ENTORNO DE LA APLICACIÓN
# Opciones disponibles: 'development' | 'integration' | 'production'
EXPO_PUBLIC_APP_ENV=development

# 2. URL BASE DE LA API GATEWAY
# ------------------------------------------------------------
# Opción A (Desarrollo Local con backend en tu máquina):
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Opción B (Integración con backend en la nube en Vercel):
# EXPO_PUBLIC_API_URL=https://tallerconect.vercel.app/api

# Opción C (Emulador Android accediendo al localhost de tu PC):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# 3. MODO DE AUTENTICACIÓN Y SERVICIOS
# true  -> Usa datos simulados (mocks) sin requerir backend activo.
# false -> Conecta directamente con la API Gateway real.
EXPO_PUBLIC_USE_MOCK_AUTH=false
