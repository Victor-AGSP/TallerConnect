# ============================================================
# TallerConnect - Plantilla de Variables de Entorno (Pública)
# ============================================================
# Copia este archivo como .env para configurar tu entorno local.
# El archivo .env está excluido de Git; este ejemplo sí se versiona.
#
# SEGURIDAD:
# Todas las variables EXPO_PUBLIC_ se incorporan al bundle del cliente
# y sus valores son visibles. Solo configurar datos públicos (URL Gateway,
# flags y límites). NUNCA incluir contraseñas, JWT, API keys, secretos,
# claves privadas ni cadenas de conexión a bases de datos.
# ============================================================

# 1. ENTORNO DE LA APLICACIÓN
# Valores: development | integration | production
EXPO_PUBLIC_APP_ENV=development

# 2. URL BASE ÚNICA DE LA API GATEWAY
# Desarrollo local (servidor Gateway en tu PC):
EXPO_PUBLIC_API_URL=http://localhost:8000/api
# Integración autorizada en Vercel:
# EXPO_PUBLIC_API_URL=https://tallerconect.vercel.app/api
# Emulador Android accediendo al localhost de tu PC:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
#
# En integration/production se exige HTTPS, origen oficial y ruta exacta /api.
# No colocar URLs /ms1, /ms2, /ms3 o /ms4.

# 3. AUTENTICACIÓN Y ADAPTADORES SIMULADOS
# true = login demo y adaptadores simulados donde el servicio lo soporta.
# false = autenticación real y adaptadores HTTP configurados.
EXPO_PUBLIC_USE_MOCK_AUTH=false
# Bandera global de compatibilidad expuesta en ENV.
EXPO_PUBLIC_USE_MOCK_SERVICES=false

# 4. TIMEOUTS HTTP (milisegundos)
# Solicitudes REST estándar: 15 segundos.
EXPO_PUBLIC_API_TIMEOUT_MS=15000
# Subida de evidencias multimedia: 60 segundos.
EXPO_PUBLIC_UPLOAD_TIMEOUT_MS=60000

# 5. CONTRATOS OPCIONALES Y VALIDACIÓN LOCAL
# Activar solo cuando el endpoint de notificaciones esté habilitado en Gateway.
EXPO_PUBLIC_ENABLE_NOTIFICATIONS_API=false
# Máximo local de evidencia por defecto: 10 MiB (no reemplaza el límite del servidor).
EXPO_PUBLIC_EVIDENCE_MAX_BYTES=10485760
